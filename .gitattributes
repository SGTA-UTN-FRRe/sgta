# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Documentation and markup
*.md text diff=markdown eol=lf
*.txt text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.svg text eol=lf

# Configuration and data
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
.editorconfig text eol=lf
.git* text eol=lf

# Code and scripts
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary formats (prevent corruption from line-ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
