# Runtime mode. Production requires every non-optional server setting below.
NODE_ENV=development

# Server-only PostgreSQL connection string. Required for database-backed
# Admin/auth flows and for production.
DATABASE_URL=

# Better Auth server settings. BETTER_AUTH_SECRET must contain at least 32
# characters. These values, DATABASE_URL, and the Google pair are required in
# production.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Google OAuth credentials. If either value is set, both must be set. Both are
# required in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Google Workspace hosted-domain restriction.
GOOGLE_HOSTED_DOMAIN=

# Optional server-only Google Sheets consultation source. Leave all five
# settings empty to keep source imports unavailable while canonical data remains
# readable. Configure the complete set together; use a service account with
# read-only access to the selected spreadsheet. Keep the private key in
# server-only configuration and encode line breaks as \n when needed.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_HEADER_MAP=
# Example header map (replace labels with the exact Sheet column headers):
# GOOGLE_SHEETS_HEADER_MAP='{"career":"Carrera","studentFirstName":"Nombre","studentLastName":"Apellido","consultationDate":"Fecha","tutor":"Tutor","academicStage":"Etapa","modality":"Modalidad","topic":"Tema","contact":"Contacto"}'

# Optional PostgreSQL URL for manual test-target tooling. The integration suite
# creates its own isolated Testcontainers database and does not require this.
TEST_DATABASE_URL=
