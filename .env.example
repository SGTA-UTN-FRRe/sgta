# Runtime mode. Production requires every non-optional server setting below.
NODE_ENV=development

# Server-only PostgreSQL connection string.
DATABASE_URL=

# Better Auth server settings. The secret must be at least 32 characters.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Google OAuth credentials. Both values are required together in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Google Workspace hosted-domain restriction.
GOOGLE_HOSTED_DOMAIN=

# Isolated PostgreSQL connection string reserved for integration tests.
TEST_DATABASE_URL=
